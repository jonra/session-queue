{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cq/message.v1.json",
  "title": "cq message, schema version 1",
  "description": "One message file, inbox/<to>/<id>.json, UTF-8 without BOM. Readers ignore unknown fields. cq always writes every field listed here.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "from",
    "to",
    "type",
    "subject",
    "body",
    "hops",
    "created"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "from": {
      "$ref": "#/$defs/name"
    },
    "to": {
      "$ref": "#/$defs/name"
    },
    "type": {
      "enum": ["task", "result", "info"]
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "description": "Markdown text. At most 20480 bytes of UTF-8 (checked by cq, not by this schema).",
      "type": "string"
    },
    "reply_to": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
    },
    "parent": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
    },
    "status": {
      "enum": [null, "ok", "failed", "rejected"]
    },
    "hops": {
      "type": "integer",
      "minimum": 0
    },
    "created": {
      "description": "UTC, RFC 3339, ending in Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "from_session_id": {
      "type": ["string", "null"]
    },
    "from_host_session_id": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "result" } }
      },
      "then": {
        "required": ["status"],
        "properties": { "status": { "enum": ["ok", "failed", "rejected"] } }
      },
      "else": {
        "properties": { "status": { "const": null } }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "id": {
      "description": "<UTC yyyymmddThhmmssZ>-<from>-<4 lowercase hex digits>",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,31}-[0-9a-f]{4}$"
    }
  }
}
